# Copy to .env for local development; every variable is validated at startup
# (libs/core/src/config/env.ts).
NODE_ENV=development
PORT=3005
# Kairos's database in ../docker-compose.yml (`docker compose up -d`).
DATABASE_URL=postgres://aether:aether@localhost:5432/kairos
# RabbitMQ in ../docker-compose.yml: Proxenos's and Hephaestus's events come
# in; Kairos's events and task.create commands go out through the outbox.
RABBITMQ_URL=amqp://aether:aether@localhost:5672
OUTBOX_RELAY_INTERVAL_MS=1000
# Pistis: every request needs its access token; Kairos's own client reads Polis.
PISTIS_ISSUER=http://localhost:3003/oidc
PISTIS_CLIENT_ID=kairos
PISTIS_CLIENT_SECRET=kairos-dev-secret
POLIS_URL=http://localhost:3001
