# Copy to .env for local development; every variable is validated at startup
# (libs/core/src/config/env.ts).
NODE_ENV=development
PORT=3006
# Kerykes's database in ../docker-compose.yml (`docker compose up -d`).
DATABASE_URL=postgres://aether:aether@localhost:5432/kerykes
# RabbitMQ in ../docker-compose.yml: Polis's and Hephaestus's events come in.
RABBITMQ_URL=amqp://aether:aether@localhost:5672
OUTBOX_RELAY_INTERVAL_MS=1000
# Pistis: every request needs its access token; Kerykes's own client reads
# Polis (memberships, projects) and Pistis (users' email addresses).
PISTIS_ISSUER=http://localhost:3003/oidc
PISTIS_URL=http://localhost:3003
PISTIS_CLIENT_ID=kerykes
PISTIS_CLIENT_SECRET=kerykes-dev-secret
POLIS_URL=http://localhost:3001
# Links in emails.
IRIS_URL=http://localhost:3000
# Email through Mailpit in ../docker-compose.yml (UI on localhost:8025).
EMAIL_DRIVER=smtp
SMTP_URL=smtp://localhost:1025
EMAIL_FROM=Aether-os <notifications@aether-os.local>
