{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": ".",
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,
    "strictPropertyInitialization": false,
    "types": [
      "vitest/globals",
      "node"
    ],
    "paths": {
      "@kerykes/core": [
        "./libs/core/src/index.ts"
      ],
      "@kerykes/core/*": [
        "./libs/core/src/*"
      ],
      "@kerykes/directory": [
        "./libs/directory/src/index.ts"
      ],
      "@kerykes/directory/*": [
        "./libs/directory/src/*"
      ],
      "@kerykes/memberships": [
        "./libs/memberships/src/index.ts"
      ],
      "@kerykes/memberships/*": [
        "./libs/memberships/src/*"
      ],
      "@kerykes/notifications": [
        "./libs/notifications/src/index.ts"
      ],
      "@kerykes/notifications/*": [
        "./libs/notifications/src/*"
      ]
    },
    "rewriteRelativeImportExtensions": true
  }
}
