{
  "name": "ergon",
  "version": "0.0.1",
  "description": "Aether-os work management: work items, assignments, dependencies and activity, for people and agents",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "deploy": "nest deploy",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"libs/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"libs/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest build && pnpm migration:run && nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main",
    "migration:run": "typeorm migration:run -d dist/src/database/data-source.js",
    "migration:show": "typeorm migration:show -d dist/src/database/data-source.js",
    "migration:generate": "typeorm migration:generate -p -d dist/src/database/data-source.js",
    "lint": "oxlint --type-aware --ignore-pattern \"libs/core/src/clients/*/generated/**\" src/ libs/ test/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "generate:api": "openapi-ts --no-log-file && aether-asyncapi-types node_modules/@aether-os/contracts/ergon.asyncapi.yaml libs/core/src/events/generated/ergon-events.gen.ts --name Ergon && aether-asyncapi-types node_modules/@aether-os/contracts/polis.asyncapi.yaml libs/core/src/events/generated/polis-events.gen.ts --name Polis && aether-asyncapi-types node_modules/@aether-os/contracts/agora.asyncapi.yaml libs/core/src/events/generated/agora-events.gen.ts --name Agora && prettier --log-level warn --write libs/core/src/api/generated libs/core/src/clients/polis/generated libs/core/src/events/generated"
  },
  "dependencies": {
    "@aether-os/krepis": "workspace:*",
    "@golevelup/nestjs-rabbitmq": "^9.1.2",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/event-emitter": "^12.0.3",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/typeorm": "^12.0.3",
    "@opentelemetry/api": "^1.10.0",
    "jose": "^6.2.17",
    "nestjs-zod": "^5.6.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^1.1.3",
    "typeorm-transactional": "^0.5.0",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@aether-os/contracts": "workspace:*",
    "@hey-api/openapi-ts": "^0.99.0",
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@testcontainers/postgresql": "^12.2.1",
    "@testcontainers/rabbitmq": "^12.2.1",
    "@types/amqplib": "^0.10.8",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "amqplib": "^0.10.9",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "testcontainers": "^12.2.1",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.2"
  },
  "dependenciesMeta": {
    "@aether-os/krepis": {
      "injected": true
    }
  }
}
