{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": ".",
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,
    "strictPropertyInitialization": false,
    "types": [
      "vitest/globals",
      "node"
    ],
    "paths": {
      "@ergon/core": [
        "./libs/core/src/index.ts"
      ],
      "@ergon/core/*": [
        "./libs/core/src/*"
      ],
      "@ergon/tenancy": [
        "./libs/tenancy/src/index.ts"
      ],
      "@ergon/tenancy/*": [
        "./libs/tenancy/src/*"
      ],
      "@ergon/assignees": [
        "./libs/assignees/src/index.ts"
      ],
      "@ergon/assignees/*": [
        "./libs/assignees/src/*"
      ],
      "@ergon/work-items": [
        "./libs/work-items/src/index.ts"
      ],
      "@ergon/work-items/*": [
        "./libs/work-items/src/*"
      ]
    },
    "rewriteRelativeImportExtensions": true
  }
}
