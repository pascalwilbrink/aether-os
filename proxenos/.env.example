# Copy to .env for local development; every variable is validated at startup
# (libs/core/src/config/env.ts).
NODE_ENV=development
PORT=3004
# Proxenos's database in ../docker-compose.yml (`docker compose up -d`).
DATABASE_URL=postgres://aether:aether@localhost:5432/proxenos
# RabbitMQ in ../docker-compose.yml; the outbox relay publishes events there.
RABBITMQ_URL=amqp://aether:aether@localhost:5672
OUTBOX_RELAY_INTERVAL_MS=1000
# Pistis: every request needs its access token; Proxenos's own client reads Polis.
PISTIS_ISSUER=http://localhost:3003/oidc
PISTIS_CLIENT_ID=proxenos
PISTIS_CLIENT_SECRET=proxenos-dev-secret
POLIS_URL=http://localhost:3001
IRIS_URL=http://localhost:3000
# The GitHub App (CLAUDE.md, "A GitHub App for local development"). Leave
# GITHUB_APP_ID unset to run without GitHub (its routes answer 503).
# GITHUB_APP_ID=123456
# GITHUB_APP_SLUG=aether-os-dev
# GITHUB_CLIENT_ID=Iv23li...
# Its secrets (privateKey, clientSecret, webhookSecret) live in OpenBao:
OPENBAO_ADDR=http://localhost:8200
OPENBAO_TOKEN=dev-root-token
