{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true
  },
  "entryFile": "src/main",
  "projects": {
    "core": {
      "type": "library",
      "root": "libs/core",
      "entryFile": "index",
      "sourceRoot": "libs/core/src",
      "compilerOptions": {
        "tsConfigPath": "libs/core/tsconfig.lib.json"
      }
    },
    "github": {
      "type": "library",
      "root": "libs/github",
      "entryFile": "index",
      "sourceRoot": "libs/github/src",
      "compilerOptions": {
        "tsConfigPath": "libs/github/tsconfig.lib.json"
      }
    },
    "tenancy": {
      "type": "library",
      "root": "libs/tenancy",
      "entryFile": "index",
      "sourceRoot": "libs/tenancy/src",
      "compilerOptions": {
        "tsConfigPath": "libs/tenancy/tsconfig.lib.json"
      }
    },
    "installations": {
      "type": "library",
      "root": "libs/installations",
      "entryFile": "index",
      "sourceRoot": "libs/installations/src",
      "compilerOptions": {
        "tsConfigPath": "libs/installations/tsconfig.lib.json"
      }
    },
    "repositories": {
      "type": "library",
      "root": "libs/repositories",
      "entryFile": "index",
      "sourceRoot": "libs/repositories/src",
      "compilerOptions": {
        "tsConfigPath": "libs/repositories/tsconfig.lib.json"
      }
    },
    "webhooks": {
      "type": "library",
      "root": "libs/webhooks",
      "entryFile": "index",
      "sourceRoot": "libs/webhooks/src",
      "compilerOptions": {
        "tsConfigPath": "libs/webhooks/tsconfig.lib.json"
      }
    }
  }
}
