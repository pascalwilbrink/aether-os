# Copy to .env for local development; every variable is validated at startup
# (libs/core/src/config/env.ts).
NODE_ENV=development
PORT=3009
# Seshat's database in ../docker-compose.yml (`docker compose up -d`; on an
# older volume: `docker compose exec postgres createdb -U aether seshat`).
DATABASE_URL=postgres://aether:aether@localhost:5432/seshat
# RabbitMQ in ../docker-compose.yml: Seshat's events go out through the outbox.
RABBITMQ_URL=amqp://aether:aether@localhost:5672
OUTBOX_RELAY_INTERVAL_MS=1000
# Pistis: every request needs its access token; Seshat's own client reads
# Polis (organizations, projects) and Loculus (documents' files).
PISTIS_ISSUER=http://localhost:3003/oidc
PISTIS_CLIENT_ID=seshat
PISTIS_CLIENT_SECRET=seshat-dev-secret
POLIS_URL=http://localhost:3001
LOCULUS_URL=http://localhost:3007
# Pylon (the model gateway): passages and queries are embedded there, charged
# to the project. Leave PYLON_URL out for keyword search only.
PYLON_URL=http://localhost:3011
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDER_INTERVAL_MS=2000
SEARCH_MIN_SIMILARITY=0.3
# Proxenos: documents of repositories linked to projects are read through it
# (leave PROXENOS_URL out to record repositories without reading them). A new
# link indexes REPOSITORY_DEFAULT_PATHS (folders end in /), at most
# REPOSITORY_MAX_DOCUMENTS files.
PROXENOS_URL=http://localhost:3004
REPOSITORY_SYNC_INTERVAL_MS=5000
REPOSITORY_DEFAULT_PATHS=docs/,specs/,adr/,README.md
REPOSITORY_MAX_DOCUMENTS=500
# How often documents are indexed, and the largest one read.
INDEXER_INTERVAL_MS=2000
DOCUMENT_MAX_BYTES=10485760

# Traces (OpenTelemetry) to the Collector in ../docker-compose.yml; leave out to
# start no telemetry (../krepis, startTelemetry).
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Logs (docs/engineering.md, Logging): error, warn, info, debug or verbose;
# json (one object per line, the default) or pretty (for a terminal). With
# telemetry on, they also go to Loki (Grafana, localhost:3300).
LOG_LEVEL=info
LOG_FORMAT=pretty
