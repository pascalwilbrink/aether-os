# Copy to .env.local. Every value has a local default outside production
# (lib/config.ts); production needs them all.
PISTIS_ISSUER=http://localhost:3003/oidc
# Iris's client at Pistis (a public client, code flow with PKCE).
IRIS_CLIENT_ID=iris
IRIS_URL=http://localhost:3000
# Encrypts the session cookie; at least 32 characters.
IRIS_SESSION_SECRET=change-me-to-a-long-random-value-of-32-chars-or-more
POLIS_URL=http://localhost:3001
HEPHAESTUS_URL=http://localhost:3002
PROXENOS_URL=http://localhost:3004
KAIROS_URL=http://localhost:3005
KERYKES_URL=http://localhost:3006
# Pistis's API (service accounts); defaults to PISTIS_ISSUER's origin.
PISTIS_URL=http://localhost:3003
