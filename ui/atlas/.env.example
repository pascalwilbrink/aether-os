# Atlas's configuration (lib/config.ts). Outside production each has a local
# default; `next start` (production) needs them all.
PISTIS_ISSUER=http://localhost:3003/oidc
ATLAS_CLIENT_ID=atlas
ATLAS_URL=http://localhost:3012
# At least 32 characters: encrypts the session cookie.
ATLAS_SESSION_SECRET=
POLIS_URL=http://localhost:3001
# Pistis's API, when not at the issuer's origin.
# PISTIS_URL=
