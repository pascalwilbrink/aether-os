# Copy to .env for local development; every variable is validated at startup
# (libs/core/src/config/env.ts).
NODE_ENV=development
PORT=3001
# Polis's database in ../docker-compose.yml (`docker compose up -d`).
DATABASE_URL=postgres://aether:aether@localhost:5432/polis
# RabbitMQ in ../docker-compose.yml; the outbox relay publishes events there.
RABBITMQ_URL=amqp://aether:aether@localhost:5672
OUTBOX_RELAY_INTERVAL_MS=1000
# Pistis (`cd ../pistis && pnpm start:dev`): every request needs its access token.
PISTIS_ISSUER=http://localhost:3003/oidc

# Traces (OpenTelemetry) to the Collector in ../docker-compose.yml; leave out to
# start no telemetry (../krepis, startTelemetry).
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Logs (docs/engineering.md, Logging): error, warn, info, debug or verbose;
# json (one object per line, the default) or pretty (for a terminal). With
# telemetry on, they also go to Loki (Grafana, localhost:3300).
LOG_LEVEL=info
LOG_FORMAT=pretty
