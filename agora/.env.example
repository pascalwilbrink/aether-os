# Copy to .env for local development; every variable is validated at startup
# (libs/core/src/config/env.ts).
NODE_ENV=development
PORT=3008
# Agora's database in ../docker-compose.yml (`docker compose up -d`; on an
# older volume: `docker compose exec postgres createdb -U aether agora`).
DATABASE_URL=postgres://aether:aether@localhost:5432/agora
# RabbitMQ in ../docker-compose.yml: Agora's events go out through the outbox.
RABBITMQ_URL=amqp://aether:aether@localhost:5672
OUTBOX_RELAY_INTERVAL_MS=1000
# Pistis: every request needs its access token; Agora's own client reads
# Polis and asks Hephaestus to check new versions.
PISTIS_ISSUER=http://localhost:3003/oidc
PISTIS_CLIENT_ID=agora
PISTIS_CLIENT_SECRET=agora-dev-secret
POLIS_URL=http://localhost:3001
HEPHAESTUS_URL=http://localhost:3002
PYLON_URL=http://localhost:3011

# Traces (OpenTelemetry) to the Collector in ../docker-compose.yml; leave out to
# start no telemetry (../krepis, startTelemetry).
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Logs (docs/engineering.md, Logging): error, warn, info, debug or verbose;
# json (one object per line, the default) or pretty (for a terminal). With
# telemetry on, they also go to Loki (Grafana, localhost:3300).
LOG_LEVEL=info
LOG_FORMAT=pretty
