# Copy to .env for local development; every variable is validated at startup
# (libs/core/src/config/env.ts).
NODE_ENV=development
PORT=3002
# Hephaestus's database in ../docker-compose.yml (`docker compose up -d`).
DATABASE_URL=postgres://aether:aether@localhost:5432/hephaestus
# Polis (run it from ../polis); asked about organizations and projects
# Hephaestus hasn't seen in Polis's events yet.
POLIS_URL=http://localhost:3001
# RabbitMQ in ../docker-compose.yml; Polis's events arrive here.
RABBITMQ_URL=amqp://aether:aether@localhost:5672
OUTBOX_RELAY_INTERVAL_MS=1000
