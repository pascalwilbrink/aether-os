# Copy to .env for local development; every variable is validated at startup
# (libs/core/src/config/env.ts).
NODE_ENV=development
PORT=3002
# Hephaestus's database in ../docker-compose.yml (`docker compose up -d`).
DATABASE_URL=postgres://aether:aether@localhost:5432/hephaestus
# Polis (run it from ../polis); asked about organizations and projects
# Hephaestus hasn't seen in Polis's events yet.
POLIS_URL=http://localhost:3001
# RabbitMQ in ../docker-compose.yml; Polis's events arrive here.
RABBITMQ_URL=amqp://aether:aether@localhost:5672
OUTBOX_RELAY_INTERVAL_MS=1000
# Pistis (`cd ../pistis && pnpm start:dev`): every request needs its access
# token, and Hephaestus gets its own (client credentials) to call Polis. The
# secret matches Pistis's development client `hephaestus`.
PISTIS_ISSUER=http://localhost:3003/oidc
PISTIS_CLIENT_ID=hephaestus
PISTIS_CLIENT_SECRET=hephaestus-dev-secret
# The runner: `none` keeps tasks queued; `mastra` runs agents with Mastra
# through the model gateway (provider keys from OpenBao, see CLAUDE.md);
# `echo` finishes every task at once without calling a model. Limits and
# timeouts: see libs/core/src/config/env.ts.
AGENT_RUNTIME=echo
# OpenBao in ../docker-compose.yml (dev mode: in memory, KV v2 at `secret`).
OPENBAO_ADDR=http://localhost:8200
OPENBAO_TOKEN=dev-root-token
# Let organizations without their own key use platform/llm/<provider>.
PLATFORM_MODEL_KEYS=true
# An Ollama server next to Hephaestus (http://localhost:11434) is allowed locally.
MODEL_ENDPOINT_ALLOW_PRIVATE=true
# Pylon, the model gateway's new home (../docs/pylon.md): true sends agents'
# model calls through it (start ../pylon too) instead of to the providers.
USE_PYLON=false
PYLON_URL=http://localhost:3011
# Sandboxes for agent versions with runtime.sandboxRequired: `docker` runs
# hardened containers on the local Docker engine; `none` fails those tasks.
SANDBOX_DRIVER=docker
SANDBOX_IMAGE=node:22-slim
# For `restricted` network access (agent versions that install packages):
# SANDBOX_ALLOWED_HOSTS=registry.npmjs.org,pypi.org,files.pythonhosted.org
# SANDBOX_PROXY_IMAGE=node:22-alpine
# SANDBOX_EGRESS_NETWORK=bridge
# Proxenos (repository tokens for tasks that work in a repository; ../proxenos).
PROXENOS_URL=http://localhost:3004
# Loculus (../loculus): files agents submit from their sandboxes (submit_file).
LOCULUS_URL=http://localhost:3007
# Tool servers (MCP) agent versions take tools from: locally they may run on
# localhost and over http. Origins trusted with a task's own token (Seshat):
TOOL_SERVER_ALLOW_PRIVATE=true
# TOOL_SERVER_TRUSTED_ORIGINS=http://localhost:3200
# TOOL_CALL_TIMEOUT_MS=60000

# Traces (OpenTelemetry) to the Collector in ../docker-compose.yml; leave out to
# start no telemetry (../krepis, startTelemetry).
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Logs (docs/engineering.md, Logging): error, warn, info, debug or verbose;
# json (one object per line, the default) or pretty (for a terminal). With
# telemetry on, they also go to Loki (Grafana, localhost:3300).
LOG_LEVEL=info
LOG_FORMAT=pretty
