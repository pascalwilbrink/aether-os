# Copy to .env for local development; every variable is validated at startup
# (libs/core/src/config/env.ts).
NODE_ENV=development
PORT=3003
# Pistis's database in ../docker-compose.yml (`docker compose up -d`).
DATABASE_URL=postgres://aether:aether@localhost:5432/pistis
# Polis's API (memberships and organizations for token claims).
POLIS_URL=http://localhost:3001
# The OIDC issuer: oidc-provider is mounted at /oidc.
PISTIS_ISSUER=http://localhost:3003/oidc
# Lowest allowed is 14; 17 is the OWASP recommendation.
PASSWORD_SCRYPT_COST=17
# External OpenID Connect providers to sign in with (none by default), e.g.
# PISTIS_UPSTREAM_PROVIDERS=[{"id":"google","name":"Google","issuer":"https://accounts.google.com","clientId":"…","clientSecret":"…"}]
# with redirect URI http://localhost:3003/interaction/callback/google registered at the provider.
# Outside production, Pistis signs with a key generated per start and a fixed
# cookie key, and registers Iris as a public client and Hephaestus as a
# platform service with client credentials (env.ts). In production
# set PISTIS_SIGNING_KEYS (a private JWKS), PISTIS_COOKIE_KEYS and PISTIS_CLIENTS.
