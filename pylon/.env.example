# Copy to .env for local development; every variable is validated at startup
# (libs/core/src/config/env.ts).
NODE_ENV=development
PORT=3011
# Pylon's database in ../docker-compose.yml (`docker compose up -d`; on an
# older volume: `docker compose exec postgres createdb -U aether pylon`).
DATABASE_URL=postgres://aether:aether@localhost:5432/pylon
# RabbitMQ in ../docker-compose.yml: Pylon's events go out through the
# outbox, Agora's (its agents) come in.
RABBITMQ_URL=amqp://aether:aether@localhost:5672
OUTBOX_RELAY_INTERVAL_MS=1000
# Pistis: every request needs its access token; Pylon's own client reads
# Polis (organizations, projects).
PISTIS_ISSUER=http://localhost:3003/oidc
PISTIS_CLIENT_ID=pylon
PISTIS_CLIENT_SECRET=pylon-dev-secret
POLIS_URL=http://localhost:3001
# OpenBao in ../docker-compose.yml: the provider keys.
OPENBAO_ADDR=http://localhost:8200
OPENBAO_TOKEN=dev-root-token
# Organizations without their own key may use the platform's
# (platform/llm/<provider> in OpenBao).
PLATFORM_MODEL_KEYS=true
# An Ollama next to Pylon (http://localhost:11434) is a private address.
MODEL_ENDPOINT_ALLOW_PRIVATE=true

# Traces (OpenTelemetry) to the Collector in ../docker-compose.yml; leave out to
# start no telemetry (../krepis, startTelemetry).
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Logs (docs/engineering.md, Logging): error, warn, info, debug or verbose;
# json (one object per line, the default) or pretty (for a terminal). With
# telemetry on, they also go to Loki (Grafana, localhost:3300).
LOG_LEVEL=info
LOG_FORMAT=pretty
