{
  "name": "@aether-os/krepis",
  "version": "0.1.0",
  "description": "Shared foundation for Aether-os NestJS services",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "lint": "oxlint --type-aware src/ test/",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config ./vitest.config.int.ts",
    "prepare": "pnpm build"
  },
  "peerDependencies": {
    "@golevelup/nestjs-rabbitmq": "^9.1.0",
    "@nestjs/common": "^12.0.0",
    "@nestjs/core": "^12.0.0",
    "@nestjs/event-emitter": "^12.0.0",
    "@nestjs/typeorm": "^12.0.0",
    "@opentelemetry/api": "^1.9.0",
    "@testcontainers/postgresql": "^12.2.0",
    "@testcontainers/rabbitmq": "^12.2.0",
    "nestjs-zod": "^5.6.0",
    "typeorm": "^1.1.0",
    "typeorm-transactional": "^0.5.0",
    "zod": "^4.6.0"
  },
  "devDependencies": {
    "@golevelup/nestjs-rabbitmq": "^9.1.2",
    "@nestjs/common": "^12.5.0",
    "@nestjs/core": "^12.5.0",
    "@nestjs/event-emitter": "^12.0.3",
    "@nestjs/platform-express": "^12.5.0",
    "@nestjs/testing": "^12.5.0",
    "@nestjs/typeorm": "^12.0.3",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/context-async-hooks": "^3.1.1",
    "@opentelemetry/core": "^3.1.1",
    "@testcontainers/postgresql": "^12.2.1",
    "@testcontainers/rabbitmq": "^12.2.1",
    "@types/amqplib": "^0.10.8",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/supertest": "^7.2.1",
    "amqplib": "^0.10.9",
    "nestjs-zod": "^5.6.0",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": "^7.0.2007",
    "pg": "^8.23.1",
    "prettier": "^3.10.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "supertest": "^7.3.2",
    "typeorm": "^1.1.3",
    "typeorm-transactional": "^0.5.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12",
    "zod": "^4.6.7"
  },
  "peerDependenciesMeta": {
    "@testcontainers/postgresql": {
      "optional": true
    },
    "@testcontainers/rabbitmq": {
      "optional": true
    }
  },
  "dependencies": {
    "jose": "^6.2.17",
    "uuid": "^14.0.3"
  }
}
